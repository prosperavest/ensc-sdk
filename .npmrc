# Supply-chain hardening - mirrors pnpm-workspace.yaml settings.
# pnpm reads both; some tooling only reads .npmrc, so we set both.
minimum-release-age=4320
auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
# Reject git: and tarball: protocols in lockfile entries
block-exotic-subdeps=true

# Use the workspace protocol explicitly for internal deps
link-workspace-packages=true
prefer-workspace-packages=true

# Save exact versions (no semver float on direct deps)
save-exact=true

# Disable lifecycle scripts by default - allowBuilds in pnpm-workspace.yaml is the allowlist
enable-pre-post-scripts=false
