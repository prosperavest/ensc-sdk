{
  "name": "ensc-sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Source of @ensc/sdk, the ENSC API client, and the two packages it bundles",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "lint": "biome check . --max-diagnostics=200",
    "lint:fix": "biome check --write .",
    "format:check": "biome format .",
    "test": "pnpm -r build && pnpm -r test",
    "check": "pnpm -r build && pnpm -r typecheck && pnpm lint && pnpm format:check && pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "typescript": "6.0.3"
  }
}
